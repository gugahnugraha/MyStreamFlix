{
  "expo": {
    "name": "MyStreamFlix",
    "slug": "mystreamflix",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gugahnugraha.mystreamflix",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      }
    },
    "extra": {
      "eas": {
        "projectId": "adc05de0-2e86-4219-84fa-b1e5a97dbb85"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
