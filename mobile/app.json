{
  "expo": {
    "name": "MyStreamFlix",
    "slug": "mystreamflix",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0A0A0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gugahnugraha.mystreamflix"
    },
    "android": {
      "package": "com.gugahnugraha.mystreamflix",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ]
  }
}
