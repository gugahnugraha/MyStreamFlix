{
  "name": "mystreamflix",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "prisma db push && node scripts/db-setup.js",
    "package": "powershell -Command \"Compress-Archive -Path app, prisma, public, src, scripts, .env.example, .gitignore, next-env.d.ts, next.config.ts, package.json, package-lock.json, postcss.config.mjs, tsconfig.json, README.md, README_ID.md, SETUP_GUIDE.md, LICENSE, CHANGELOG.md -DestinationPath MyStreamFlix.zip -Force\"",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.0.0",
    "capacitor-video-player": "^6.0.2",
    "dashjs": "^5.2.0",
    "hls.js": "^1.6.17",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.1",
    "tailwindcss": "^4.0.0-beta.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4.0.0-beta.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "typescript": "~5.8.2"
  }
}
